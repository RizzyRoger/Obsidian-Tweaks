{
  "name": "rollover-categorical-todos",
  "version": "1.0.0",
  "description": "Roll unfinished todos from the previous daily note into today's matching checkbox categories.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "keywords": ["obsidian", "plugin", "todos"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.17.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
